# ============================================================================
# CreatorLoop (DarkPAKI VIP) — Environment Configuration Template
# ============================================================================
# NOTE: Never commit real production secrets, API keys, or private keys to source control.

# Server Core
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters
ADMIN_PIN=7860
DB_PATH=data/darkpaki.db
CORS_ORIGIN=*

# Google Identity Services (OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=your_google_web_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudflare Turnstile Bot Shield (Anti-Bot Verification)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Video Storage & Delivery (Local or S3/Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=media_cache/uploads
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_BUCKET=creatorloop-videos
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
CDN_STREAM_URL=https://darkpaki-stream.onrender.com

# AI Moderation Engine (Provider-Agnostic Adapter)
# Options: mock | openai | perspective
AI_MODERATION_MODE=mock
AI_MODERATION_API_KEY=your_moderation_provider_key_here

# Financial Safety & Compliance Gates (Strictly Disabled by Default)
ENABLE_CASH_WITHDRAWALS=false
ENABLE_CRYPTO_PAYOUTS=false
ENABLE_VIEW_REWARDS=false
ENABLE_REWARDED_ADS=false
