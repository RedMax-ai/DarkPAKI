# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://rewards:rewards_secret@localhost:5432/rewards_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Google OAuth 2.0 ────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Cloudflare Turnstile ────────────────────────────────
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000

# ─── JWT / Session ───────────────────────────────────────
JWT_ACCESS_SECRET=generate-a-64-char-random-string-here
JWT_REFRESH_SECRET=generate-a-different-64-char-random-string-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CSRF ────────────────────────────────────────────────
CSRF_SECRET=generate-a-32-char-random-string-here

# ─── Encryption (for payment details at rest) ────────────
ENCRYPTION_KEY=generate-a-32-byte-hex-key-here
ENCRYPTION_IV_LENGTH=16

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Admin ───────────────────────────────────────────────
INITIAL_ADMIN_GOOGLE_ID=your-google-id-for-first-admin
